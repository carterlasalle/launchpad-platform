LAUNCHPAD_ENV=development
LAUNCHPAD_GITHUB_API=https://api.github.com
LAUNCHPAD_VERCEL_API=https://api.vercel.com
LAUNCHPAD_CLOUDFLARE_API=https://api.cloudflare.com/client/v4
LAUNCHPAD_GITHUB_TOKEN=
LAUNCHPAD_VERCEL_TOKEN=
LAUNCHPAD_VERCEL_TEAM_ID=
LAUNCHPAD_CLOUDFLARE_TOKEN=
LAUNCHPAD_CLOUDFLARE_ACCOUNT_ID=
# HTTPS endpoint of the shared authoritative DNS resolver. Production deploys
# render this from GitHub environment vars and reject absent, placeholder, or
# non-HTTPS values before Wrangler runs. See apps/controller/src/dns-resolver.ts.
LAUNCHPAD_AUTHORITATIVE_DNS_RESOLVER_URL=
LAUNCHPAD_OIDC_ISSUER=https://token.actions.githubusercontent.com
LAUNCHPAD_OIDC_AUDIENCE=https://launchpad.example.internal
LAUNCHPAD_OIDC_JWKS=https://token.actions.githubusercontent.com/.well-known/jwks
LAUNCHPAD_OPERATOR_TOKEN=
CONTROLLER_INTERNAL_TOKEN=
CONTROLLER_INTERNAL_URL=http://127.0.0.1:8787
CONTROL_REPOSITORY=carterlasalle/launchpad-platform
CONTROL_CATALOG_ROOT=catalog/apps

# Live sandbox acceptance (yarn acceptance:live; opt-in via
# LAUNCHPAD_LIVE_ACCEPTANCE=1). Every LP_LIVE_* variable must name a
# DEDICATED sandbox resource whose id/name contains LP_LIVE_SANDBOX_PREFIX;
# ambiguous or production targets are refused. See scripts/acceptance-live.mjs.
LAUNCHPAD_LIVE_ACCEPTANCE=
LP_LIVE_SANDBOX_PREFIX=lp-live-
LP_LIVE_GITHUB_TOKEN=
LP_LIVE_GITHUB_REPOSITORY=
LP_LIVE_GITHUB_REPOSITORY_ID=
LP_LIVE_VERCEL_TOKEN=
LP_LIVE_VERCEL_TEAM_ID=
LP_LIVE_VERCEL_PROJECT=
LP_LIVE_CLOUDFLARE_TOKEN=
LP_LIVE_CLOUDFLARE_ZONE=
LP_LIVE_DOMAIN=
