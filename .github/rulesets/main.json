{
  "$comment": "Machine-readable desired state for the control repository's main-branch ruleset (ADR-0001). Verified against the live GitHub ruleset by scripts/verify-ruleset.mjs before every production release. No Terraform.",
  "name": "launchpad-main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "repository": {
    "default_branch": "main",
    "squash_merge_only": true
  },
  "rules": [
    {
      "type": "creation",
      "parameters": {
        "include": ["refs/heads/main"],
        "exclude": []
      }
    },
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_checks": [
          { "context": "platform / schema" },
          { "context": "platform / catalog" },
          { "context": "platform / provider-preflight" },
          { "context": "platform / plan" },
          { "context": "platform / preview" },
          { "context": "platform / health" },
          { "context": "dependency / review" }
        ]
      }
    }
  ]
}
