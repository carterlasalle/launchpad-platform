{
  "name": "launchpad",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "workflows"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -t run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "acceptance:offline": "node scripts/acceptance-offline.mjs",
    "acceptance:live": "node scripts/acceptance-live.mjs",
    "lint": "eslint .",
    "docs:check": "node scripts/check-docs.mjs",
    "typecheck": "tsc -b",
    "validate": "yarn platform validate",
    "plan": "yarn platform plan",
    "status": "yarn platform status",
    "platform": "yarn workspace @launchpad/cli launchpad"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hono": "4.13.9",
    "jose": "6.2.12",
    "yaml": "2.9.1"
  },
  "resolutions": {
    "nanoid@npm:^3.3.17": "npm:3.3.18",
    "undici@npm:7.28.0": "npm:7.29.1",
    "undici@npm:7.29.0": "npm:7.29.1",
    "undici@npm:^8.4.1": "npm:8.10.2",
    "fast-uri@npm:^3.0.1": "npm:3.1.8",
    "brace-expansion@npm:^5.0.8": "npm:5.0.12",
    "sharp@npm:0.35.2": "npm:0.35.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260927.1",
    "@types/node": "26.6.3",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "typescript": "5.8.3",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
