{
  "name": "@launchpad/cli",
  "private": true,
  "type": "module",
  "bin": {
    "launchpad": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@launchpad/catalog": "workspace:*",
    "@launchpad/core": "workspace:*",
    "@launchpad/database": "workspace:*",
    "@launchpad/github-reporting": "workspace:*",
    "@launchpad/health": "workspace:*",
    "@launchpad/provider-cloudflare": "workspace:*",
    "@launchpad/provider-contract": "workspace:*",
    "@launchpad/provider-github": "workspace:*",
    "@launchpad/provider-testkit": "workspace:*",
    "@launchpad/provider-vercel": "workspace:*",
    "@launchpad/workflows": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  },
  "scripts": {
    "launchpad": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  }
}
